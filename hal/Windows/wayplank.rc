#include <winver.h>
#include "wayplank-ver.h"

1 24 "wayplank.manifest"
101 ICON "wayplank.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WAYPLANK_VER_CSV
 PRODUCTVERSION WAYPLANK_VER_CSV
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", WAYPLANK_COMPANY_STR
            VALUE "FileDescription", "WayPlank Monolithic Desktop Dock\0"
            VALUE "FileVersion", WAYPLANK_VER_STR
            VALUE "InternalName", "wayplank\0"
            VALUE "LegalCopyright", WAYPLANK_COPYRIGHT_STR
            VALUE "OriginalFilename", "wayplank.exe\0"
            VALUE "ProductName", WAYPLANK_PRODUCT_STR
            VALUE "ProductVersion", WAYPLANK_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
