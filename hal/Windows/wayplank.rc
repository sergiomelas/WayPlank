#include <winver.h>

#ifndef WAYPLANK_VER_RAW
#define WAYPLANK_VER_RAW 0.7.3
#endif
#define WP_STR_HELPER(x) #x
#define WP_STR(x) WP_STR_HELPER(x)
#define WAYPLANK_VER_STR WP_STR(WAYPLANK_VER_RAW)

1 24 "wayplank.manifest"
101 ICON "wayplank.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,3,0
 PRODUCTVERSION 0,7,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WayPlank Project (Sergio Melas)\0"
            VALUE "FileDescription", "WayPlank Monolithic Desktop Dock\0"
            VALUE "FileVersion", WAYPLANK_VER_STR
            VALUE "InternalName", "wayplank\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Sergio Melas (GPLv3)\0"
            VALUE "OriginalFilename", "wayplank.exe\0"
            VALUE "ProductName", "WayPlank\0"
            VALUE "ProductVersion", WAYPLANK_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
